# .gitignore — common for all three projects

# Data: creditcard.csv (~67 MB) IS committed on purpose so GitHub Actions
# can retrain on a schedule without Kaggle credentials. Don't add other raw data.
*.zip

# Trained models and metrics can be regenerated by running training
artifacts/*.joblib

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/

# Jupyter
.ipynb_checkpoints/

# OS / IDE
.DS_Store
Thumbs.db
.idea/
.vscode/

# Logs
*.log
training_log.txt
